# Projeto Supabase exclusivo do Mapa da Pesquisa.
NEXT_PUBLIC_SUPABASE_URL=https://aeaweherkrqmlqnxsmib.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Identificador usado como proteção contra conexão ao projeto errado.
NEXT_PUBLIC_SUPABASE_PROJECT_REF=aeaweherkrqmlqnxsmib
GOOGLE_AUTH_ENABLED=false
GEMINI_API_KEY=
# Credencial exclusiva do Mapa; mantenha no servidor (não use NEXT_PUBLIC_).
RESEARCH_STARTER_MAPA_API_KEY=
RESEARCH_STARTER_API_KEY=
NEXT_PUBLIC_APP_URL=https://mapadapesquisa.com.br
NEXT_PUBLIC_APP_VERSION=v26082026.4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# E-mails transacionais (Resend). Verifique mapadapesquisa.com.br antes de ativar em produção.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAPA_NOTIFICATION_FROM=Mapa da Pesquisa <notificacao@mapadapesquisa.com.br>
MAPA_NOTIFICATION_NOREPLY=Mapa da Pesquisa <noreply@mapadapesquisa.com.br>

# Rollout server-side do fluxo v2.
# enabled: novos prompts criam v2; disabled: fallback v1; admin_only: usar MAPA_V2_ALLOWED_EMAILS.
MAPA_V2_ROLLOUT=enabled
MAPA_V2_ALLOWED_EMAILS=

# Verificação ponta-a-ponta aluno/orientador.
# Use contas de teste controladas e já confirmadas no Supabase.
# Se quiser que o script crie contas explicitamente fornecidas, use MAPA_E2E_CREATE_USERS=true.
MAPA_E2E_STUDENT_EMAIL=
MAPA_E2E_ADVISOR_EMAIL=
MAPA_E2E_PASSWORD=
MAPA_E2E_CREATE_USERS=false

# Nunca inclua secret key, service_role, senha do banco ou access token aqui.
