{
  "name": "mapa-da-pesquisa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "supabase:verify": "node --env-file-if-exists=.env.local scripts/verify-supabase.mjs",
    "supabase:verify-rls": "node --env-file-if-exists=.env.local scripts/verify-anonymous-rls.mjs",
    "supabase:verify-authenticated-rls": "node --env-file-if-exists=.env.local scripts/verify-authenticated-rls.mjs",
    "supabase:verify-migration-local": "sh scripts/verify-migration-local.sh",
    "research-starter:verify": "node --env-file-if-exists=.env.local scripts/verify-research-starter.mjs",
    "gemini:verify": "node --env-file-if-exists=.env.local scripts/verify-gemini.mjs",
    "test": "node --test tests/foundation.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.99",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "ai": "6.0.234",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.14",
    "sharp": "0.35.3"
  },
  "type": "module"
}
